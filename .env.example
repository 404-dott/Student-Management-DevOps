# ==========================================================
# Student Management System - Environment Variables Template
# ==========================================================

# Flask App Configuration
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database Connection (MySQL)
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=student_db

# Fallback Mode (Set to true to use SQLite without MySQL)
USE_SQLITE=false
