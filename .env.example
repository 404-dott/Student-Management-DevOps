# ==============================================================================
# Environment Configuration Template for Student Management DevOps Project
# Copy this file to .env and adjust variables for your deployment environment
# ==============================================================================

# Application Security
SECRET_KEY=student-devops-secure-jwt-session-key-change-in-production-2026
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# MySQL Database Configuration (Used in Docker Compose & Production)
DB_HOST=db
DB_PORT=3306
DB_NAME=student_db
DB_USER=student_user
DB_PASSWORD=student_pass
DB_ROOT_PASSWORD=rootpassword

# Local Development / Automated Testing SQLite Fallback
# Set USE_SQLITE=true to test without running a MySQL server
USE_SQLITE=false
SQLITE_DB_PATH=students_dev.db

# Docker Compose Port Bindings
FRONTEND_PORT=80
BACKEND_PORT=5000
MYSQL_PORT=3306

# CI/CD & Registry Settings
DOCKERHUB_USERNAME=your-dockerhub-username
